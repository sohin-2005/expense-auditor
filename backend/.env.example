# ── Backend environment variables ──────────────────────────────────────────
# Copy to `backend/.env` for local dev:  cp backend/.env.example backend/.env
# In production these are set in the Render dashboard (Environment tab).
# `backend/.env` is gitignored — never commit real values.

# ── Supabase (required) ────────────────────────────────────────────────────
# Supabase → Project Settings → API.
# The backend uses the SERVICE ROLE key (not the anon key): it bypasses RLS,
# so it must stay server-side only. Missing values do not crash the process —
# /health reports them in `boot_errors` and returns "degraded".
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Receipt storage ────────────────────────────────────────────────────────
# Name of the PRIVATE Supabase Storage bucket receipts are written to.
# Create it under Storage → New bucket, with "Public bucket" OFF: the backend
# serves receipts through short-lived signed URLs, gated on ownership.
# If the bucket is missing, uploads fall back to local disk and log a warning
# — and on Render that disk is wiped on every deploy, so the receipt is lost.
# SUPABASE_RECEIPT_BUCKET=receipts

# ── Currency ───────────────────────────────────────────────────────────────
# The currency every analytics total and claim total is expressed in.
# Expenses keep their original amount and currency; `amount_base` is what
# aggregates. An expense whose currency has no row in the `fx_rates` table is
# LEFT OUT of totals and reported as unconverted, never folded in at 1:1 —
# seed rates with the statement at the bottom of backend/db/003_fx.sql.
# Changing this later means re-running that file's backfill block.
# BASE_CURRENCY=USD

# ── AI providers ───────────────────────────────────────────────────────────
# GEMINI_API_KEY is required for image receipts: vision tasks run on Gemini
# only and have no fallback provider. Without it, every image upload returns
# 503 and /health reports "degraded".
# https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# GROQ_API_KEY is the fallback for TEXT tasks only (PDF receipt text, policy
# audits, trip planning). Optional, but with it a Gemini outage no longer
# takes down text auditing.  https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# ── Policy retrieval ───────────────────────────────────────────────────────
# How policy context is chosen for an audit:
#   shadow  (default) run both paths, decide with the old keyword trimmer,
#           and log where the two disagree. Policy retrieval decides whether
#           people get reimbursed, so it earns a comparison period on real
#           traffic before it decides anything.
#   vector  hybrid retrieval over policy_chunks, with verified citations.
#   keyword the original substring trimmer, no retrieval at all.
# Switch to `vector` once the shadow logs look right. Requires
# db/005_policy_chunks.sql and a policy re-uploaded since then.
# POLICY_RETRIEVAL_MODE=shadow

# Embedding model for policy chunks. Gemini-only — Groq exposes no embedding
# model, so there is no fallback, exactly as with vision. 768 is one of the
# three supported widths for gemini-embedding-001 and must match the
# vector(768) column in db/005_policy_chunks.sql: changing either means
# altering that column and re-embedding every chunk.
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768

# ── CORS (required in production) ──────────────────────────────────────────
# Comma-separated exact origins allowed to call this API. localhost:5173 and
# any https://*.vercel.app origin are already allowed without being listed.
# FRONTEND_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# ── Optional tuning (defaults in backend/ai_provider.py :: load_config) ─────
# Smaller prompt/context budgets for lower latency and token cost. Default: 1.
# EXPENSE_AUDIT_FAST_MODE=1
# Which model each task uses. Do not "upgrade" these without re-verifying
# against the live account — see the comments in backend/ai_provider.py.
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_VISION_MODEL=gemini-3.5-flash
# GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# Set to `groq` to try Groq before Gemini for text tasks. Default: gemini.
# AI_PRIMARY_PROVIDER=gemini
# Per-request timeout and retry count for AI calls. Defaults: 45.0 and 1.
# A malformed value falls back to the default with a logged warning.
# AI_TIMEOUT_SECONDS=45
# AI_RETRIES=1
