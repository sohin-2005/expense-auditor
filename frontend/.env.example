# ── Frontend environment variables ─────────────────────────────────────────
# Copy to `frontend/.env` for local dev. In production these must be set in
# Vercel → Project → Settings → Environment Variables, then REDEPLOY —
# Vite inlines VITE_* values at build time, so a restart alone won't pick
# up changes.

# Backend API base URL (no trailing slash).
# Local:      http://127.0.0.1:8000
# Production: https://<your-render-service>.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Supabase project URL and ANON (public) key — both required.
# Supabase → Project Settings → API. Never put the service_role key here:
# anything VITE_* is inlined into the public JS bundle.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_KEY=<your-supabase-anon-key>
